# Server
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# MongoDB (read-only catalog)
MONGODB_URI=mongodb+srv://catalog-readonly:vcRvxWHQSKUEwd7V@catalog.sontifs.mongodb.net/catalog
MONGODB_DB_NAME=catalog
MONGODB_PRODUCTS_COLLECTION=products

# HTTP
CORS_ORIGIN=http://localhost:5173
JSON_BODY_LIMIT=1mb
MAX_UPLOAD_BYTES=10485760

# Lexical search
LEXICAL_DEFAULT_LIMIT=20
LEXICAL_MAX_LIMIT=100

# LLM — OpenRouter for vision, chat, rerank, and embeddings (one key)
# Get a key at https://openrouter.ai/keys
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_VISION_MODEL=openai/gpt-4o
LLM_CHAT_MODEL=openai/gpt-4o
LLM_EMBED_BASE_URL=https://openrouter.ai/api/v1
LLM_EMBED_MODEL=openai/text-embedding-3-small

LLM_REQUEST_TIMEOUT_MS=60000

# Required by OpenRouter for attribution
OPENROUTER_REFERER=http://localhost:5173
OPENROUTER_TITLE=Furniture Vision Search
OPENROUTER_HOST=openrouter.ai

# Local dev API key (gitignored — add to .env only, never commit)
# OPENROUTER_API_KEY=sk-or-v1-...
